{
    "name": "helpdesk-server",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "node --watch --env-file=.env src/index.js",
        "start": "node src/index.js",
        "db:generate": "drizzle-kit generate",
