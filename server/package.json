{
    "name": "helpdesk-server",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "node --watch --env-file=.env src/index.js",
        "start": "node --env-file-if-exists=.env src/db/migrate.js && node --env-file-if-exists=.env src/db/seed.js && node --env-file-if-exists=.env src/index.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:seed": "node --env-file-if-exists=.env src/db/seed.js",
        "db:studio": "drizzle-kit studio",
        "db:seed-examples": "node --env-file=.env src/db/seed-examples.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1146.0",
        "@aws-sdk/lib-storage": "^3.1146.0",
        "bcryptjs": "^3.0.3",
        "drizzle-orm": "^0.45.3",
        "express": "^5.2.1",
        "imapflow": "^2.2.4",
        "mailparser": "^3.9.34",
        "multer": "^2.4.0",
        "nodemailer": "^10.0.14",
        "pg": "^8.23.0",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "drizzle-kit": "^0.31.11"
    },
    "engines": {
        "node": "22.x"
    }
}
