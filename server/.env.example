# Copy this file to .env and fill in your own values.
# .env is never uploaded to GitHub, so your passwords stay on your computer.

# How the server connects to the (PostgreSQL) database. Either the whole
# link:
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://helpdesk:CHANGE_ME@localhost:5432/helpdesk_db
# ...or, instead of DATABASE_URL, the parts a hosting panel shows
# (e.g. SiteGround → Site → PostgreSQL). Any password works here, even
# with symbols in it:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# On SiteGround's Node.js Projects (docs/siteground.md)
# HOSTING=siteground
# One folder for attached files, backups and the secret key, outside the
# app's code so new deployments don't remove them:
# DATA_DIR=

# The port the API runs on
PORT=4000

# The first account, created by "npm run db:seed". Use your real details.
SUPER_ADMIN_NAME=Your Name
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_TOO

# ---------- Settings → Domain & SSL ----------
# On your own server (Linode, Google Cloud, Oracle, homelab...): install
# Caddy once with "sudo bash deploy/install-caddy.sh". The helpdesk sets
# Caddy up by itself. All of these are optional:
#   SITE_DOMAIN: the site's main domain, e.g. helpdesk.darmani.com
#     (several: separate them with commas). Added to Settings → Domain
#     & SSL by itself the first time the server starts, so it's secure
#     even before anyone has signed in. After that, add, change or
#     remove domains in Settings.
#   SERVER_IP: this server's public IP, shown as where the A record
#     should point. Leave it empty and it's found by itself.
#   CADDY_EMAIL: email for the Let's Encrypt account. Leave it empty to
#     use SUPER_ADMIN_EMAIL.
#   CADDY_ADMIN: set to off if this computer's Caddy is used for other
#     things and the helpdesk shouldn't change its settings.
#   HOST: set to 127.0.0.1 on a server so the app can only be reached
#     through Caddy (https). Leave it out while developing.
SITE_DOMAIN=
SERVER_IP=
CADDY_EMAIL=

# On Render (testing): Render makes and renews the certificate instead.
#   RENDER_API_KEY: Render → Account Settings → API Keys → Create API Key.
#   RENDER_SERVICE_ID: the web service's ID (srv-...). Render sets this
#     one by itself on the live site; only fill it in here to try locally.
RENDER_API_KEY=
RENDER_SERVICE_ID=

# Optional: force "server" or "render" instead of choosing by itself
# SSL_MODE=

# ---------- Maintenance: AI investigations (older setups only) ----------
# AI investigations are now set up in the helpdesk itself: Maintenance →
# AI & GitHub (docs/maintenance.md). Nothing is needed here. These lines
# are only for setups made before that, and stop being used once GitHub
# is connected on the page.
#   MAINT_GITHUB_REPO: owner/repository (must be private)
#   MAINT_GITHUB_TOKEN: a fine-grained token with Issues read/write only
#   MAINT_AUTO_INVESTIGATE: on (default) or off (then only the button)
#   MAINT_MAX_PER_DAY / MAINT_MAX_PER_MONTH: limits (3 and 20)
MAINT_GITHUB_REPO=
MAINT_GITHUB_TOKEN=
# MAINT_AUTO_INVESTIGATE=on
# MAINT_MAX_PER_DAY=3
# MAINT_MAX_PER_MONTH=20
#   MAINT_GITHUB_WEBHOOK_SECRET: GitHub tells the helpdesk at once when a
#     fix is merged or closed (docs/maintenance.md, step 6)
#   MAINT_APPROVERS: optional, GitHub logins whose merge counts as approval
MAINT_GITHUB_WEBHOOK_SECRET=
# MAINT_APPROVERS=
